{
    "name": "aistudio-to-api",
    "version": "1.3.5",
    "author": "Ellinav, iBenzene, bbbugg",
    "description": "Encapsulate Gemini models on AI Studio as API services.",
    "main": "main.js",
    "scripts": {
        "dev": "concurrently --kill-others --handle-input \"npm run dev:server\" \"npm run dev:ui\"",
        "dev:server": "cross-env NODE_ENV=development nodemon main.js",
        "dev:ui": "vite build --watch",
        "predev": "npm run build:ui && npm run prepare",
        "build:ui": "vite build",
        "preview:ui": "vite preview",
        "test": "node --test tests/*.mjs",
        "start": "cross-env NODE_ENV=production node main.js",
        "quick-start": "cross-env NODE_ENV=production node main.js",
        "prestart": "npm run build:ui",
        "save-auth": "node scripts/auth/saveAuth.js",
        "setup-auth": "node scripts/auth/setupAuth.js",
        "setup-auth-batch": "node scripts/auth/setupAuthBatch.js",
        "prepare": "husky install",
        "lint": "eslint . && stylelint \"ui/**/*.{css,less}\"",
        "lint:fix": "eslint . --fix && stylelint \"ui/**/*.{css,less}\" --fix",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"ui/**/*.{css,less}\"",
        "lint:js:fix": "eslint . --fix",
        "lint:css:fix": "stylelint \"ui/**/*.{css,less}\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit_token_limits": "python3 scripts/ci/audit_token_limits.py",
        "audit_memory_bank": "python3 scripts/ci/audit_memory_bank.py",
        "verify_git_gate": "python3 scripts/ci/lint_rules_section.py",
        "lint_ui_ux_archive": "python3 scripts/ci/lint_ui_ux_archive.py",
        "lint_refactor_doc_sync": "python3 scripts/ci/lint_refactor_doc_sync.py",
        "lint:ci": "python3 scripts/ci/lint_rules_section.py && python3 scripts/ci/lint_core_file_format.py && python3 scripts/ci/lint_deployment_artifacts.py && python3 scripts/ci/lint_aes_summary_format.py && python3 scripts/ci/audit_token_limits.py && python3 scripts/ci/audit_memory_bank.py && python3 scripts/ci/lint_ui_ux_archive.py && python3 scripts/ci/lint_refactor_doc_sync.py",
        "verify": "npm run lint && npm run test && npm run lint:ci",
        "artifact:sync": "python3 scripts/ci/sync_deployment_version.py",
        "remote:8318:start": "bash scripts/dev/remote_8318.sh start",
        "remote:8318:stop": "bash scripts/dev/remote_8318.sh stop",
        "remote:8318:status": "bash scripts/dev/remote_8318.sh status",
        "remote:8318:logs": "bash scripts/dev/remote_8318.sh logs",
        "healthcheck": "bash scripts/dev/healthcheck.sh"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "axios": "^1.13.2",
        "basic-auth": "^2.0.1",
        "cookie-parser": "^1.4.6",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-session": "^1.18.0",
        "jszip": "^3.10.1",
        "mime-types": "^3.0.2",
        "playwright": "1.59.1",
        "ws": "^8.17.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@babel/eslint-parser": "^7.28.5",
        "@vitejs/plugin-vue": "^5.1.0",
        "@vue/shared": "^3.4.26",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.3",
        "element-plus": "^2.7.2",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^2.18.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-sort-keys-fix": "^1.1.2",
        "eslint-plugin-vue": "^9.33.0",
        "husky": "^8.0.3",
        "less": "^4.4.2",
        "less-plugin-clean-css": "^1.6.0",
        "lint-staged": "^14.0.0",
        "lodash-es": "^4.18.1",
        "nodemon": "^3.1.0",
        "prettier": "^3.7.4",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^36.0.1",
        "stylelint-config-standard-less": "^3.0.1",
        "stylelint-less": "^3.0.1",
        "stylelint-order": "^7.0.0",
        "vite": "^5.4.8",
        "vue": "^3.4.26",
        "vue-eslint-parser": "^10.2.0",
        "vue-router": "^4.3.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "ui/**/*.vue": [
            "eslint --fix",
            "prettier --write"
        ],
        "ui/locales/*.json": [
            "eslint --fix",
            "prettier --write"
        ],
        "configs/models.json": [
            "eslint --fix",
            "prettier --write"
        ],
        "ui/**/*.{css,less}": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{md,yml,yaml}": "prettier --write"
    }
}
